# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example

# ---------- Spring Boot / Java ----------
target/
*.class

# Maven generated files
.mvn/timing.properties

# ---------- IDEs ----------
.vscode/
.idea/
*.iml
*.iws
*.ipr

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.springBeans
.sts4-cache
.apt_generated
.factorypath

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ---------- Build Files ----------
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- Logs ----------
*.log
logs/

# ---------- Frontend / Node ----------
node_modules/
dist/
build/

# ---------- Temporary Files ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- Operating System ----------
.DS_Store
Thumbs.db

# ---------- Local Database / Data ----------
*.db
*.sqlite
*.sqlite3

# ---------- Coverage / Test Reports ----------
coverage/
*.coverage

# ---------- Spring Boot generated files ----------
HELP.md